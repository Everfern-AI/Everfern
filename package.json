{
  "name": "desktop",
  "version": "1.3.0",
  "description": "EverFern — The AI agent that truly controls your system.",
  "author": "Everfern Community <everfernsupport@gmail.com>",
  "license": "MIT",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev:electron": "tsc -p tsconfig.electron.json -w",
    "prebuild:electron-ts": "node -e \"require('fs').rmSync('dist-electron', { recursive: true, force: true })\"",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml && node -e \"const fs=require('fs'),p=require('path');const ext={win32:'dll',darwin:'dylib'}[process.platform]||'so';const pre=process.platform==='win32'?'':'lib';fs.mkdirSync('native/bin',{recursive:true});fs.copyFileSync(p.join('native/target/release',pre+'everfern_native.'+ext),'native/bin/everfern-native.'+process.platform+'-'+process.arch+'.node');console.log('[Build] native module copied')\"",
    "build:electron-ts": "tsc -p tsconfig.electron.json",
    "postbuild:electron-ts": "node -e \"const fs=require('fs'),path=require('path');const src='main/lib/migrations',dst='dist-electron/main/lib/migrations';fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).filter(f=>f.endsWith('.sql')).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)));console.log('[Build] SQL migrations copied to dist-electron');const pSrc='main/agent/prompts',pDst='dist-electron/main/agent/prompts';fs.cpSync(pSrc,pDst,{recursive:true});console.log('[Build] Prompt files copied to dist-electron');const sSrc='main/skills',sDst='dist-electron/main/skills';fs.cpSync(sSrc,sDst,{recursive:true});console.log('[Build] Skills copied to dist-electron');const oSrc='main/ocr',oDst='dist-electron/main/ocr';fs.mkdirSync(oDst,{recursive:true});fs.copyFileSync(path.join(oSrc,'ocr_pdf.py'),path.join(oDst,'ocr_pdf.py'));console.log('[Build] OCR script copied to dist-electron')\"",
    "dev": "npm run build:electron-ts && cross-env NEXT_TELEMETRY_DISABLED=1 UV_THREADPOOL_SIZE=16 concurrently -k \"next dev --turbopack -p 3001\" \"wait-on tcp:3001 && electron .\"",
    "tauri:dev": "npm run build:electron-ts && cross-env NEXT_TELEMETRY_DISABLED=1 UV_THREADPOOL_SIZE=16 concurrently -k \"next dev --turbopack -p 3001\" \"wait-on tcp:3001 && cargo run --manifest-path src-tauri/Cargo.toml\"",
    "tauri:sidecar": "node tauri/sidecar/boot.js",
    "build:next": "next build --webpack",
    "build:electron": "npm run build:electron-ts && electron-builder",
    "build:linux": "npm run build:next && npm run build:electron-ts && electron-builder --linux",
    "build:macos": "npm run build:next && npm run build:electron-ts && electron-builder --macos",
    "build:macos:arm64": "npm run build:next && npm run build:electron-ts && electron-builder --macos --arm64",
    "build:macos:x64": "npm run build:next && npm run build:electron-ts && electron-builder --macos --x64",
    "build": "npm run build:next && npm run build:electron-ts && electron-builder",
    "rebuild:electron": "cross-env SHARP_IGNORE_GLOBAL_LIBVIPS=1 electron-rebuild -f",
    "rebuild:electron:arm64": "cross-env SHARP_IGNORE_GLOBAL_LIBVIPS=1 electron-rebuild -f -a arm64",
    "rebuild:electron:x64": "cross-env SHARP_IGNORE_GLOBAL_LIBVIPS=1 electron-rebuild -f -a x64",
    "start": "electron-forge start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "tauri:prepare": "node scripts/prepare-tauri.cjs",
    "tauri:test": "cargo test --manifest-path src-tauri/Cargo.toml --bin everfern",
    "tauri:package": "node scripts/build-tauri.cjs"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "Everfern-AI",
        "repo": "Everfern"
      }
    ],
    "appId": "com.everfern.desktop",
    "productName": "EverFern",
    "afterSign": "scripts/after-sign-mac.cjs",
    "copyright": "Copyright © 2026 EverFern",
    "npmRebuild": true,
    "icon": "public/images/logos/everfern.ico",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/@jitsi/robotjs/**/*",
      "**/node_modules/sharp/**/*",
      "**/node_modules/sqlite-vec/**/*",
      "**/node_modules/uiohook-napi/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "everfern-app",
        "schemes": [
          "everfern-app"
        ]
      }
    ],
    "files": [
      "dist-electron/**/*",
      "package.json",
      "native/bin/*.node",
      "!.next/**",
      "!out/**",
      "!public/**",
      "!main/**",
      "!src/**",
      "!src-tauri/**",
      "!release*/**",
      "!native/target/**",
      "!native/src/**",
      "!coverage/**",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts",
      "!**/*.mp4",
      "!**/*.webm",
      "!public/demo/**/*",
      "!dist-electron/**/__tests__/**",
      "!dist-electron/**/*.test.js",
      "!dist-electron/**/*.spec.js",
      "!**/node_modules/**/{test,tests,__tests__,example,examples,docs,doc,.github,coverage,benchmark,benchmarks}/**",
      "!**/node_modules/**/*.{md,markdown,ts,tsx,mts,cts,flow,pdb,obj,lib,iobj,ipdb,tlog,exp,ilk,cc,cpp,c,h,hpp,gyp,gypi,mk,o}",
      "!**/node_modules/**/{README,CHANGELOG,HISTORY,AUTHORS,CONTRIBUTING}*",
      "!**/node_modules/**/{.eslintrc*,.prettierrc*,tsconfig*.json,.editorconfig,.npmignore,.travis.yml}",
      "!**/node_modules/sqlite3/build/Release/obj/**",
      "!**/node_modules/sqlite3/{deps,src}/**",
      "!**/node_modules/@xenova/transformers/dist/**",
      "!**/node_modules/onnxruntime-web/dist/!(ort-web.node.js)",
      "!**/node_modules/onnxruntime-web/lib/**"
    ],
    "extraResources": [
      {
        "from": "main/skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "main/agent/prompts",
        "to": "prompts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "public",
        "filter": [
          "favicon.ico",
          "images/logos/**/*",
          "sounds/**/*"
        ]
      },
      {
        "from": "out",
        "to": "out",
        "filter": [
          "**/*",
          "!dev/**",
          "!demo/**",
          "!cache/**",
          "!fonts/fonts/**",
          "!**/MatterMono*",
          "!**/MatterSemiMono*",
          "!**/MatterCollectionVF*",
          "!**/*.map",
          "!**/*.mp4",
          "!**/*.webm"
        ]
      },
      {
        "from": "../extension-navis",
        "to": "extension-navis",
        "filter": [
          "dist/**/*",
          "src/**/*",
          "manifest.*.json",
          "package.json",
          "README.md"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/images/logos/everfern.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "files": [
        "!**/node_modules/koffi/build/koffi/!(darwin_*)/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/{win32,linux}/**",
        "!**/node_modules/@img/sharp-{win32,linux,linuxmusl,wasm32}*/**",
        "!**/node_modules/@img/sharp-libvips-{linux,linuxmusl}*/**"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/images/logos/everfern.ico",
      "artifactName": "${productName}.Setup.${version}.${ext}",
      "files": [
        "!**/node_modules/koffi/build/koffi/!(win32_*)/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/{darwin,linux}/**",
        "!**/node_modules/@img/sharp-{darwin,linux,linuxmusl,wasm32}*/**",
        "!**/node_modules/@img/sharp-libvips-{darwin,linux,linuxmusl}*/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EverFern"
    },
    "linux": {
      "category": "Productivity",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "public/images/logos/everfern.png",
      "files": [
        "!**/node_modules/koffi/build/koffi/!(linux_*|musl_*)/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/{win32,darwin}/**",
        "!**/node_modules/@img/sharp-{win32,darwin,wasm32}*/**",
        "!**/node_modules/@img/sharp-libvips-darwin*/**"
      ]
    }
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.21",
    "@langchain/core": "^1.1.36",
    "@langchain/langgraph": "^1.2.5",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.3.1",
    "@mariozechner/pi-coding-agent": "^0.63.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.106.2",
    "@xenova/transformers": "^2.17.2",
    "adm-zip": "^0.5.17",
    "cheerio": "^1.2.0",
    "discord.js": "^14.14.1",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "fast-glob": "^3.3.3",
    "html-dom-parser": "^8.0.0",
    "js-beautify": "^1.15.4",
    "node-telegram-bot-api": "^0.66.0",
    "openai": "^6.34.0",
    "playwright": "^1.59.1",
    "pptxgenjs": "^4.0.1",
    "search-engine-nodejs": "^1.0.9",
    "sharp": "^0.34.5",
    "socket.io-client": "^4.8.3",
    "sqlite-vec": "^0.1.7",
    "sqlite3": "^6.0.1",
    "string-similarity": "^4.0.4",
    "uiohook-napi": "^1.5.5",
    "winreg": "^1.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.12.24",
    "@assistant-ui/react-markdown": "^0.12.8",
    "@base-ui/react": "^1.7.0",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.3",
    "@heroicons/react": "^2.2.0",
    "@ibm-cloud/watsonx-ai": "^1.7.11",
    "@livekit/components-react": "^2.9.20",
    "@openuidev/react-lang": "^0.2.4",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cheerio": "^0.22.35",
    "@types/dom-mediacapture-record": "^1.0.22",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^20",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/play-sound": "^1.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sqlite3": "^3.1.11",
    "@types/string-similarity": "^4.0.2",
    "@types/winreg": "^1.2.36",
    "@vitest/coverage-v8": "^4.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-react": "^6.2.6",
    "better-sqlite3": "^12.8.0",
    "canvas": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "diff": "^8.0.4",
    "electron": "41.0.3",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "fast-check": "^4.6.0",
    "framer-motion": "^12.42.2",
    "ibm-cloud-sdk-core": "^5.4.11",
    "jsdom": "^29.0.2",
    "livekit-client": "^2.18.1",
    "lottie-react": "^3.0.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.1",
    "node-gyp": "^12.2.0",
    "parse-diff": "^0.11.1",
    "picomatch": "^4.0.4",
    "play-sound": "^1.1.6",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1",
    "screenshot-desktop": "^1.15.3",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tiktoken": "^1.0.22",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.10",
    "typescript": "^5",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.4"
  }
}
