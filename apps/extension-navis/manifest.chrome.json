{
  "manifest_version": 3,
  "name": "EverFern Navis",
  "description": "Extension-first browser control for EverFern Navis.",
  "version": "0.1.7",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "scripting",
    "sidePanel",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "EverFern Navis",
    "default_icon": {
      "16": "logos/tray-icon.png",
      "32": "logos/tray-icon.png",
      "48": "logos/tray-icon.png",
      "128": "logos/everfern-rounded.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "logos/tray-icon.png",
    "32": "logos/tray-icon.png",
    "48": "logos/tray-icon.png",
    "128": "logos/everfern-rounded.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logos/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:4001 http://127.0.0.1:4001 ws://localhost:4001 http://localhost:4001 * ws: wss: http: https:;"
  }
}
